+// ------------------------------------------------------------------ conector MCP remoto
+/** Comparação em tempo constante (o segredo da URL é a credencial do conector). */
+function mesmoSegredo(a: string, b: string): boolean {
+	const x = new TextEncoder().encode(a);
+	const y = new TextEncoder().encode(b);
+	let d = x.length ^ y.length;
+	for (let i = 0; i < Math.max(x.length, y.length); i++) d |= (x[i] ?? 0) ^ (y[i] ?? 0);
+	return d === 0;
+}
+
+const ORIGENS_MCP = /^https:\/\/([a-z0-9-]+\.)*(claude\.ai|claude\.com|anthropic\.com)$/;
+
+/** Adaptadores do Worker para o núcleo MCP compartilhado com o plugin (`mcp.ts`). */
+export function ambienteRemoto(env: Env): AmbienteMcp {
+	const pedido = (env.MCP_PAPEL ?? '').trim().toUpperCase();
+	const papel: Papel = pedido !== 'AGENTE' && (PAPEIS as readonly string[]).includes(pedido) ? (pedido as Papel) : 'LEITOR';
+	const temGithub = Boolean(env.GITHUB_TOKEN || (env.GITHUB_APP_ID && env.GITHUB_APP_PRIVATE_KEY && env.GITHUB_INSTALLATION_ID));
+	return {
+		origem: 'mcp-remoto',
+		ator: { email: env.MCP_OPERADOR || 'conector@claude.ai', papel },
+		fonte: env.OPS_REPO,
+		prefixo: '/',
+		semGithub: temGithub ? undefined : { lacuna: 'Worker sem credencial do GitHub: configure o secret GITHUB_TOKEN (ou o GitHub App).', proxima: 'wrangler secret put GITHUB_TOKEN' },
+		tarefas: () => tarefasDe(env),
+		defs: () => definicoes(env),
+		ledger: async () => new Ledger(env.LEDGER),
+		verificarLink: (u) => verificarLink(u),
+		// Sem disco: o relatório volta na própria resposta (texto + HTML A4 em structuredContent.html).
+		relatorio: async (r) => ({ refs: [], html: htmlImpressao(r.dados), gaps: r.formato === 'pdf' ? ['PDF: o conector remoto devolve o HTML A4 (structuredContent.html) para imprimir como PDF; o arquivo PDF só no plugin local.'] : [] }),
+		semEnvio: { lacuna: 'e-mail: o conector remoto não envia e-mail. No claude.ai, crie um rascunho com o conector Gmail usando o texto (ou structuredContent.html) desta resposta; o envio é do usuário.', proxima: 'Gmail: create_draft com o relatório' },
+		espelho: async (abas) => ({ refs: [], texto: Object.entries(abas).map(([nome, linhas]) => `## ${nome}\n${csv(linhas)}`).join('\n\n') }),
+	};
+}
+
+/**
+ * MCP por HTTP, sem sessão nem SSE: cada POST é uma mensagem JSON-RPC e a resposta é JSON.
+ * Autenticação: segredo na URL (decisão do usuário, emenda 2026-09-26b) — sem segredo configurado,
+ * ou diferente, responde 404 como qualquer rota inexistente. Escrita segue as regras do núcleo:
+ * papel do conector (LEITOR por padrão), `consultar` recusa escrita e o lote pede /confirmar.
+ */
+export async function tratarMcp(request: Request, env: Env, segredo: string): Promise<Response> {
+	if (!env.MCP_SEGREDO || env.MCP_SEGREDO.length < 32 || !mesmoSegredo(segredo, env.MCP_SEGREDO)) return new Response('não encontrado', { status: 404 });
+	const origem = request.headers.get('origin');
+	if (origem && !ORIGENS_MCP.test(origem)) return new Response('origem não permitida', { status: 403 });
+	if (request.method !== 'POST') return new Response(null, { status: 405, headers: { allow: 'POST' } });
+	const corpo = (await request.json().catch(() => undefined)) as Rpc | Rpc[] | undefined;
+	if (corpo === undefined || Array.isArray(corpo)) return Response.json({ jsonrpc: '2.0', id: null, error: { code: -32700, message: 'Envie uma mensagem JSON-RPC por requisição.' } }, { status: 400 });
+	const resposta = await tratarRpc(corpo, () => ambienteRemoto(env));
+	if (resposta === null) return new Response(null, { status: 202 }); // notificação
+	log({ evento: 'mcp', metodo: corpo.method, ferramenta: (corpo.params as { name?: string } | undefined)?.name ?? null });
+	return Response.json(resposta);
+}

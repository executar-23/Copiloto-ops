+	assert.equal((await rpc(env({ MCP_SEGREDO: 'curto' }), 'initialize', {}, { segredo: 'curto' })).status, 404);
+	assert.equal((await rpc(env(), 'initialize', {}, { segredo: 'x'.repeat(40) })).status, 404);
+	assert.equal((await rpc(env(), 'initialize', {}, { headers: { origin: 'https://malicioso.example' } })).status, 403);
+	assert.equal((await rpc(env(), 'initialize', {}, { headers: { origin: 'https://claude.ai' } })).status, 200);

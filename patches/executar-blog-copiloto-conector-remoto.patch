+// Conector MCP remoto do Copiloto (rota /mcp/<segredo> do Worker; ADR-016, emenda 2026-09-26b):
+// mesmo núcleo do plugin, ledger D1 (simulado em SQLite), GitHub simulado em HTTP. Nada sai da máquina.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import http from 'node:http';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { test } from 'node:test';
+import { tratar } from '../../apps/copiloto/worker/index.ts';
+
+const raiz = path.resolve(import.meta.dirname, '../..');
+const SEGREDO = 's'.repeat(40);
+
+function d1() {
+	const db = new DatabaseSync(':memory:');
+	db.exec(fs.readFileSync(path.join(raiz, 'apps/copiloto/migrations/0001_ledger.sql'), 'utf8'));
+	return {
+		prepare(sql) {
+			const st = db.prepare(sql);
+			return { bind: (...v) => ({ run: async () => ({ meta: { changes: Number(st.run(...v).changes) } }), first: async () => st.get(...v) ?? null, all: async () => ({ results: st.all(...v) }) }) };
+		},
+	};
+}
+
+/** GitHub simulado: lista de issues do repositório operacional e contagem de escritas. */
+function githubFalso() {
+	const escritas = [];
+	const srv = http.createServer((req, res) => {
+		req.resume();
+		req.on('end', () => {
+			const u = new URL(req.url, 'http://x');
+			if (req.method !== 'GET') escritas.push(`${req.method} ${u.pathname}`);
+			res.writeHead(u.pathname === '/repos/o/ops/issues' && req.method === 'GET' ? 200 : 404, { 'content-type': 'application/json' });
+			res.end(u.pathname === '/repos/o/ops/issues' && req.method === 'GET' ? '[]' : '{"message":"Not Found"}');
+		});
+	});
+	return new Promise((ok) => srv.listen(0, '127.0.0.1', () => ok({ escritas, url: `http://127.0.0.1:${srv.address().port}`, fechar: () => srv.close() })));
+}
+
+const env = (extra = {}) => ({ LEDGER: d1(), FILA: { send: async () => {} }, OPS_REPO: 'o/ops', BLOG_REPO: 'o/blog', EMAIL_FROM: 'f', MCP_SEGREDO: SEGREDO, ...extra });
+let id = 0;
+const rpc = (e, method, params, { segredo = SEGREDO, headers = {} } = {}) =>
+	tratar(new Request(`https://c/mcp/${segredo}`, { method: 'POST', headers: { 'content-type': 'application/json', ...headers }, body: JSON.stringify({ jsonrpc: '2.0', id: ++id, method, params }) }), e);
+const chamar = async (e, name, args = {}) => (await (await rpc(e, 'tools/call', { name, arguments: args })).json()).result.structuredContent;
+
+test('conector remoto: sem segredo, segredo curto ou errado → 404; origem estranha → 403; GET → 405', async () => {
